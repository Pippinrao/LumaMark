{
  "name": "lumamark",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/perf/**",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "pnpm quality:web-build && playwright test --config playwright.production.config.ts",
    "test:live-assets": "pnpm test:live-assets:public && pnpm test:live-assets:rust",
    "test:live-assets:public": "node scripts/quality/test-live-assets.mjs",
    "test:live-assets:rust": "cargo test --manifest-path src-tauri/Cargo.toml --test remote_image_live -- --ignored --nocapture",
    "test:fixtures": "vitest run tests/fixtures",
    "download:markdown-corpus": "node scripts/quality/download-markdown-corpus.mjs",
    "test:markdown-corpus": "node scripts/quality/test-markdown-corpus.mjs",
    "perf:bench": "vitest run tests/perf --no-file-parallelism",
    "quality:v1-ux-prototype": "playwright test tests/e2e/v1-ux-prototype.spec.ts",
    "quality:v1-ux-screenshots": "node scripts/quality/capture-v1-ux-screenshots.mjs",
    "quality:web-build": "node scripts/quality/verify-web-build.mjs",
    "release:verify-artifacts": "node scripts/release/verify-windows-artifacts.mjs",
    "release:packaged-webview": "pnpm build && node scripts/release/verify-packaged-webview.mjs",
    "release:installer-smoke:plan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/windows-installer-smoke.ps1 -PlanOnly",
    "release:installer-smoke:nsis": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/windows-installer-smoke.ps1 -InstallerKind Nsis"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.0",
    "@radix-ui/react-context-menu": "^2.3.2",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-menubar": "^1.1.19",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tanstack/react-virtual": "3.14.5",
    "@tauri-apps/api": "^2.11.1",
    "cmdk": "^1.1.1",
    "codemirror-markdown-tables": "1.0.0",
    "i18next": "^26.3.4",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-arborist": "^3.12.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-resizable-panels": "^4.12.1",
    "react-zoom-pan-pinch": "4.0.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
